{
  "manifest_version": 3,
  "name": "رصد الحضور السريع — مدرستي",
  "short_name": "رصد مدرستي",
  "version": "1.6.2",
  "description": "رصد حضور الحصص غير المرصودة في منصة مدرستي بضغطة زر، مع نسخ الغياب من الحصص المرصودة، وإقفال اليوم، وسجل يومي.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://schools.madrasati.sa/*"
  ],
  "action": {
    "default_title": "رصد الحضور السريع",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://schools.madrasati.sa/*"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}