{
  "manifest_version": 3,
  "name": "رصد الحضور السريع — مدرستي",
  "short_name": "رصد مدرستي",
  "version": "1.2.1",
  "description": "رصد حضور الحصص غير المرصودة في منصة مدرستي بضغطة زر، مع خيار تسجيل الغائبين.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["https://schools.madrasati.sa/*"],
  "action": {
    "default_title": "رصد الحضور السريع",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
